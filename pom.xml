<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xtg.xtdocs</groupId>
  <artifactId>pdf-sdk-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>PDF SDK :: Parent</name>
  <description>Production-grade Java SDK for converting files to PDF.</description>
  <!--<url>https://github.com/xtg/xtdocs-pdf-sdk</url>-->

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>xtg</id>
      <name>XTG</name>
      <email>dev@xtg.example</email>
    </developer>
  </developers>

  <!--<scm>
    <connection>scm:git:https://github.com/xtg/xtdocs-pdf-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/xtg/xtdocs-pdf-sdk.git</developerConnection>
    <url>https://github.com/xtg/xtdocs-pdf-sdk</url>
    <tag>HEAD</tag>
  </scm>-->

  <modules>
    <module>pdf-sdk-bom</module>
    <module>pdf-sdk-api</module>
    <module>pdf-sdk-core</module>
    <module>pdf-sdk-engine-pdfbox</module>
    <module>pdf-sdk-testkit</module>
  </modules>

  <properties>
    <!--
      Target Java 8 bytecode for maximum consumer reach. The build JDK
      itself must be 17 or higher (see Enforcer rule below); JDK 21 is
      what compiles this project. JDK 22+ may drop release 8 support;
      if that becomes a blocker, revisit this decision.
    -->
    <maven.compiler.release>8</maven.compiler.release>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>

    <pdfsdk.streamingThresholdBytes>524288</pdfsdk.streamingThresholdBytes>
    <pdfsdk.maxInputBytes>2147483648</pdfsdk.maxInputBytes>
    <pdfsdk.maxImagePixels>100000000</pdfsdk.maxImagePixels>
    <pdfsdk.tempDirBudgetBytes>10737418240</pdfsdk.tempDirBudgetBytes>

    <pdfbox.version>3.0.3</pdfbox.version>
    <slf4j.version>2.0.13</slf4j.version>
    <tika.version>2.9.2</tika.version>

    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>
    <archunit.version>1.3.0</archunit.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.6.3</maven-javadoc-plugin.version>
    <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    <maven-dependency-plugin.version>3.6.1</maven-dependency-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.xtg.xtdocs</groupId>
        <artifactId>pdf-sdk-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xtg.xtdocs</groupId>
        <artifactId>pdf-sdk-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xtg.xtdocs</groupId>
        <artifactId>pdf-sdk-engine-pdfbox</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xtg.xtdocs</groupId>
        <artifactId>pdf-sdk-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tika</groupId>
        <artifactId>tika-core</artifactId>
        <version>${tika.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <!-- -options: suppress the "source 8 is obsolete" warning from JDK 21+ -->
              <arg>-Xlint:all,-serial,-processing,-options</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <argLine>-Xmx512m -XX:MaxDirectMemorySize=256m -XX:+UseG1GC</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <argLine>-Xmx512m -XX:MaxDirectMemorySize=256m -XX:+UseG1GC</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-hygiene</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- The JDK running the build. Not the target bytecode version. -->
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
				<banDynamicVersions>
				  <!--
					Allow SNAPSHOT versions for our own modules during development.
					Version ranges like [1.0,) and LATEST/RELEASE keywords remain banned.
				  -->
				  <allowSnapshots>true</allowSnapshots>
				</banDynamicVersions>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <doclint>all,-missing</doclint>
          <quiet>true</quiet>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>